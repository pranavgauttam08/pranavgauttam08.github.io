{
  "name": "pranavgauttam08-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Static site that ships a validated JSON-LD entity graph on every page.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:strict": "node scripts/validate.mjs --strict",
    "test": "node --test",
    "bots": "node scripts/check-bots.mjs",
    "logs": "node scripts/analyze-logs.mjs",
    "check": "npm run build && npm run validate:strict && npm test"
  }
}
